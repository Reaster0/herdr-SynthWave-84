{
  "terminal_menu": "menu-tr",
  "id": "root",
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "workspace-chrome-tr"
          },
          "size": {
            "px": 46
          },
          "window_drag": true
        },
        {
          "id": "sidebar-system",
          "hidden": false,
          "type": "block",
          "size": {
            "px": 48
          },
          "content": {
            "props": {
              "monitorSlot": "sidebar-system",
              "sidebar": true
            },
            "mod": "system-windows"
          }
        },
        {
          "id": "sidebar-quota",
          "hidden": false,
          "type": "block",
          "size": {
            "px": 145
          },
          "content": {
            "props": {
              "monitorSlot": "sidebar-quota",
              "sidebar": true
            },
            "mod": "quota"
          }
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "space-folders"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            },
            {
              "id": "agents",
              "type": "block",
              "content": {
                "mod": "agents-tr"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "workspace-chrome-tr",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 69
          }
        }
      ],
      "size": {
        "px": 360
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "topbar",
          "type": "row",
          "children": [
            {
              "id": "tabs",
              "type": "block",
              "content": {
                "mod": "tabs-tr"
              },
              "size": {
                "weight": 1
              },
              "window_drag": true
            },
            {
              "content": {
                "mod": "monitor-position"
              },
              "type": "block",
              "id": "monitor-position-button",
              "size": {
                "px": 138
              }
            },
            {
              "id": "task-presets-button",
              "type": "block",
              "size": {
                "px": 110
              },
              "content": {
                "props": {
                  "launcher": true
                },
                "mod": "task-presets-tr"
              }
            }
          ],
          "size": {
            "px": 42
          },
          "resizable": false
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "pane"
                    },
                    "reveal": "always",
                    "height": 30,
                    "position": "top"
                  },
                  "background": "background",
                  "border": {
                    "width": 1,
                    "color": "#495495"
                  },
                  "focus": {
                    "width": 2,
                    "color": "#ff7edb"
                  },
                  "radius": 10,
                  "gap": 8,
                  "lone": true
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files-tr"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    }
                  ],
                  "active": "files"
                }
              ],
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "hidden": true
            },
            {
              "id": "agent-resources-panel",
              "type": "block",
              "hidden": true,
              "size": {
                "px": 370
              },
              "min": 330,
              "max": 600,
              "content": {
                "mod": "agent-resources-tr"
              }
            }
          ],
          "padding": 8,
          "gap": 8
        },
        {
          "id": "status",
          "type": "row",
          "children": [
            {
              "id": "status-main",
              "type": "block",
              "content": {
                "mod": "workspace-status-tr"
              },
              "size": {
                "weight": 1
              }
            },
            {
              "id": "status-system",
              "hidden": true,
              "type": "block",
              "size": {
                "px": 360
              },
              "content": {
                "props": {
                  "monitorSlot": "status-system"
                },
                "mod": "system-windows"
              }
            },
            {
              "id": "status-quota",
              "hidden": true,
              "type": "block",
              "size": {
                "px": 470
              },
              "content": {
                "props": {
                  "names": true,
                  "monitorSlot": "status-quota"
                },
                "mod": "quota"
              }
            }
          ],
          "size": {
            "px": 28
          },
          "resizable": false
        }
      ],
      "resizable": false
    }
  ],
  "background": {
    "gradient": [
      "#2b1d44",
      "#171520"
    ],
    "angle": 180
  },
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "#ff7edb40"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "theme": "synthwave-84",
  "preview": "layouts/synthwave-84.svg",
  "font": "DejaVu Sans Mono"
}
